{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blackmath88/expertise-to-process/schemas/library-entry.schema.json",
  "title": "Pietro library entry (schemaVersion 1)",
  "description": "Documentation of the contract. The authoritative, dependency-free validator is docs/app/lib/library.js (validateEntry / validateLibrary), run by `npm run validate:library`. It additionally checks taxonomy membership, cross-entry references, folder/path rules, payload size (64 kB per entry), v1 process graph validity, and that fictional entries claim neither effectiveness nor authority.",
  "type": "object",
  "required": ["schemaVersion", "id", "kind", "title", "summary", "fictional", "context", "classification", "provenance", "review", "effectiveness", "authority", "maintenance", "relatedIds", "patternIds"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 60},
    "kind": {"enum": ["process-example", "improvement-case", "pattern"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "summary": {"type": "string", "minLength": 1, "maxLength": 600},
    "fictional": {"type": "boolean"},
    "context": {
      "type": "object", "required": ["scope", "constraints"],
      "properties": {"scope": {"type": "string", "maxLength": 600}, "constraints": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 600}}}
    },
    "classification": {
      "type": "object", "required": ["familyId", "activityTags", "frictionTags"],
      "description": "IDs must exist in docs/app/data/taxonomy.json.",
      "properties": {"familyId": {"type": "string"}, "activityTags": {"type": "array", "items": {"type": "string"}}, "frictionTags": {"type": "array", "items": {"type": "string"}}}
    },
    "provenance": {
      "type": "object", "required": ["sourceType", "sourceLabel", "sourceRefs"],
      "properties": {"sourceType": {"enum": ["fictional-example", "curated-pattern", "contribution"]}, "sourceLabel": {"type": "string", "maxLength": 400}, "sourceRefs": {"type": "array", "items": {"type": "string"}}}
    },
    "review": {
      "description": "Formal review. Independent of effectiveness and authority.",
      "type": "object", "required": ["status", "reviewedByRole", "reviewedAt"],
      "properties": {"status": {"enum": ["not-reviewed", "pending-review", "reviewed"]}, "reviewedByRole": {"type": ["string", "null"]}, "reviewedAt": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}
    },
    "effectiveness": {
      "description": "Tested effect. Anything other than 'untested' requires evidenceRefs.",
      "type": "object", "required": ["status", "evidenceRefs"],
      "properties": {"status": {"enum": ["untested", "anecdotal", "measured"]}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}}
    },
    "authority": {
      "description": "Who made what binding for whom. Anything other than 'none' requires scope and authoritySource.",
      "type": "object", "required": ["status", "scope", "authoritySource"],
      "properties": {"status": {"enum": ["none", "local-practice", "binding"]}, "scope": {"type": ["string", "null"]}, "authoritySource": {"type": ["string", "null"]}}
    },
    "maintenance": {
      "type": "object", "required": ["ownerRole", "reviewDue"],
      "properties": {"ownerRole": {"type": ["string", "null"]}, "reviewDue": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}
    },
    "relatedIds": {"type": "array", "items": {"type": "string"}},
    "patternIds": {"type": "array", "items": {"type": "string"}, "description": "Must reference entries of kind 'pattern'."},
    "openQuestions": {"type": "array", "items": {"type": "string", "maxLength": 600}},
    "process": {"description": "Existing v1 process model (docs/app/model.js normalize). Required unless kind is 'pattern'.", "type": "object"},
    "pattern": {
      "description": "Required for kind 'pattern'.",
      "type": "object", "required": ["steps", "prerequisites", "limits", "questionsBeforeReuse"],
      "properties": {
        "steps": {"type": "array", "minItems": 1, "maxItems": 15, "items": {"type": "object", "required": ["label"], "properties": {"label": {"type": "string"}, "roleHint": {"type": ["string", "null"]}}}},
        "prerequisites": {"type": "array", "items": {"type": "string"}},
        "limits": {"type": "array", "items": {"type": "string"}},
        "questionsBeforeReuse": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "pattern"}}}, "then": {"required": ["pattern"], "not": {"required": ["process"]}}, "else": {"required": ["process"], "not": {"required": ["pattern"]}}}
  ]
}
